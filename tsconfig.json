{
  "compilerOptions": {
    "paths": { "@/*": ["./src/*"] },
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "moduleDetection": "force",
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": false,
    "noUncheckedSideEffectImports": true,
    "types": ["bun"]
  },
  "include": ["src", "tests", "scripts"]
}
